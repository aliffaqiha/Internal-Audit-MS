# Azure deployment configuration for the IAMS backend.
# Copy this file to deploy/azure/.env (already gitignored) and fill in the values.
# The user must have the Azure CLI installed (az login) and be authenticated.

# --- Locations ---
AZURE_LOCATION=eastasia
RESOURCE_GROUP=rg-iams

# --- PostgreSQL ---
PG_SERVER=iams-pg
PG_DB=iams
PG_USER=iams
PG_PASSWORD=ChangeMe_SuperStrong

# --- Redis ---
REDIS_NAME=iams-redis

# --- Container Registry ---
ACR_NAME=iamsacr

# --- Container Apps ---
CAE_NAME=cae-iams
CA_API_NAME=ca-api
CA_MINIO_NAME=ca-minio
MINIO_USER=iams_minio
MINIO_PASSWORD=iams_minio_secret

# --- App secrets (REQUIRED, must be >= 32 chars) ---
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=

# --- Seed admin (initial login) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULLNAME=System Administrator

# --- Vercel frontend (REQUIRED) ---
# Origin shown in the browser, e.g. https://internal-audit-ms.vercel.app (no trailing slash)
CORS_ORIGIN=
# API base URL used by the frontend (usually identical to CORS_ORIGIN)
CLIENT_BASE_URL=

# --- Optional custom domain for the API (e.g. api.iams.example.com) ---
# If left empty, the script skips the custom-domain/set certificate step.
API_DOMAIN=